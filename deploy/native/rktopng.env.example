# RkTopNG configuration. Installed as /etc/rktopng/rktopng.env (read by the
# systemd unit). Every line is optional: the defaults suit a native install.
# After editing:  sudo systemctl restart rktopng

# TCP port of the HTTP server (/metrics, /api/stats, /api/stream, /api/processes)
#RKTOP_PORT=9888

# How often the live stream (/api/stream) pushes a snapshot
#RKTOP_INTERVAL=1s

# Behind a reverse proxy that keeps the prefix in the address (Nginx Proxy Manager
# location /rktopng -> http://<this host>:9888): serve everything under it.
#RKTOP_BASE_PATH=/rktopng

# Ask for a password on EVERYTHING (HTTP Basic), /metrics included. Set both or
# neither: only one stops the service from starting. This file holds the password,
# so install.sh keeps it readable by root only.
#RKTOP_AUTH_USER=admin
#RKTOP_AUTH_PASSWORD=change-me

# How many processes are kept in the process list
#RKTOP_PROC_TOP=20

# SMART data (disk temperature/health) needs the `smartctl` command
# (Debian/Ubuntu: sudo apt install smartmontools) and root.
#RKTOP_SMART=off                  # off|0|false disables SMART polling
#RKTOP_SMART_INTERVAL=60s         # how often each disk is queried
#RKTOP_SMARTCTL=/usr/sbin/smartctl

# Expose /debug/pprof/ to profile CPU use (off by default: it shows internals).
#RKTOP_PPROF=1

# --- Only for running inside a container, where the host's files are mounted
# --- somewhere else. A native install never needs these.
#RKTOP_PROC_PATH=/host/proc
#RKTOP_SYS_PATH=/host/sys
#RKTOP_ROOTFS_PATH=/host/root
#RKTOP_OSRELEASE_PATH=/host/os-release
#RKTOP_PASSWD_PATH=/host/passwd
#RKTOP_DEV_PATH=/dev
